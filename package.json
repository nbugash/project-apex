{
  "name": "apex-shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ds:sync": "node scripts/ds-sync.mjs",
    "dev": "vite",
    "build": "npm run ds:sync && vite build",
    "tauri": "tauri",
    "test:unit": "vitest run",
    "lint": "eslint .",
    "lint:ds": "eslint src && node scripts/lint-ds.mjs",
    "e2e": "wdio run tests/e2e/wdio.conf.ts",
    "perf:budget": "vitest run tests/perf",
    "smoke:macos": "bash scripts/smoke-macos.sh",
    "stub:connection": "node scripts/stub-connection.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gate:fidelity": "node tools/gate-fidelity/compare.mjs",
    "gate:fidelity:update": "node tools/gate-fidelity/update.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/mocha": "^10.0.10",
    "@typescript-eslint/parser": "^8.70.0",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "eslint": "^9.0.0",
    "prettier": "^3.9.8",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.0.0",
    "svelte-eslint-parser": "^1.8.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.0.0",
    "webdriverio": "^9.32.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0"
  }
}
